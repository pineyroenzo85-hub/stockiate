# stockIAte - Plantilla de variables de entorno
# ==============================================
# Copiar este archivo como `.env` y completar los valores.
# El `.env` real NO va a git (está en .gitignore) porque contiene secretos.

# --- Roboflow (detección por imagen) ---
# Key de la API. Se saca desde app.roboflow.com, en la config del workspace.
# Sin esto, main.py falla al arrancar.
ROBOFLOW_API_KEY=

# Config del Workflow "text-recognition" (detección + OCR de marca).
# Estos tres tienen default en roboflow_workflow.py, así que se pueden
# dejar vacíos salvo que uses otro workspace o workflow.
ROBOFLOW_WORKSPACE_NAME=cooppers-workspace
ROBOFLOW_WORKFLOW_ID=text-recognition
ROBOFLOW_API_URL=https://serverless.roboflow.com

# --- Groq (chatbot IA) ---
# Inferencia gratuita con límites de uso. Conseguir la key en
# https://console.groq.com/keys
# A diferencia de Roboflow, la validación es lazy: si falta, el resto del
# backend sigue andando y solo /chatbot responde 503.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
