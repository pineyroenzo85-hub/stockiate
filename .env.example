# stockIAte - Plantilla de variables de entorno
# ==============================================
# Copiar este archivo como `.env` y completar los valores.
# El `.env` real NO va a git (está en .gitignore) porque contiene secretos.

# --- Roboflow (detección por imagen) ---
# Key de la API. Se saca desde app.roboflow.com, en la config del workspace.
# Sin esto, main.py falla al arrancar.
ROBOFLOW_API_KEY=

# Config del Workflow "text-recognition" (detección + OCR de marca).
# Estos tres tienen default en roboflow_workflow.py, así que se pueden
# dejar vacíos salvo que uses otro workspace o workflow.
ROBOFLOW_WORKSPACE_NAME=cooppers-workspace
ROBOFLOW_WORKFLOW_ID=text-recognition
ROBOFLOW_API_URL=https://serverless.roboflow.com

# --- Groq (chatbot IA) ---
# Inferencia gratuita con límites de uso. Conseguir la key en
# https://console.groq.com/keys
# A diferencia de Roboflow, la validación es lazy: si falta, el resto del
# backend sigue andando y solo /chatbot responde 503.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Keys de repuesto (opcionales, hasta GROQ_API_KEY_9). Si la de arriba se
# queda sin cupo (429), el chatbot pasa solo a la siguiente y sigue
# respondiendo. Ojo: los términos de Groq no permiten abrir cuentas extra
# para esquivar los límites del plan gratuito.
# GROQ_API_KEY_2=


# --- WhatsApp Cloud API (notificaciones) ---
# OJO: esto NO es la app "WhatsApp Business" del celular, que no tiene API.
# Es la WhatsApp Business Platform, que se administra en
# https://developers.facebook.com -> tu app -> WhatsApp -> Configuración de la API.
#
# Token de acceso. El que muestra esa pantalla es TEMPORAL (dura 24 h) y sirve
# sólo para probar: para que las notificaciones no mueran solas hay que generar
# uno permanente desde business.facebook.com -> Configuración del negocio ->
# Usuarios del sistema, con los permisos `whatsapp_business_messaging` y
# `whatsapp_business_management` y caducidad "Nunca".
# Si falta, la validación es lazy (como la de Groq): el resto del sistema anda
# igual y las notificaciones quedan en la cola como 'fallida'.
WHATSAPP_TOKEN=

# Identificador del número de teléfono EMISOR (no es tu celular: es el número
# de prueba +1 555... que da Meta). Está en la misma pantalla, como
# "Identificador del número de teléfono".
WHATSAPP_PHONE_NUMBER_ID=

# Versión de la Graph API. Poner la que muestre el panel de Meta en los
# ejemplos de curl; tiene default en whatsapp.php así que se puede dejar vacía.
WHATSAPP_API_VERSION=v23.0

# --- Modo de la aplicación ---
# `normal` (o la clave ausente) = la base real `stockiate`.
# `demo`   = la base `stockiate_demo`, con los datos inventados que siembra
#            `php seed_demo.php`. Son dos bases distintas: nada de lo que se
#            haga en demo puede tocar los datos del comercio.
# En modo demo todas las pantallas muestran una banda naranja arriba, para que
# ninguna captura de pantalla se pueda confundir con datos reales.
STOCKIATE_MODO=normal

# --- Otros ---
# Dónde están los endpoints PHP. Lo usa chatbot_ia.py para resolver las
# herramientas del chatbot. Tiene default, sólo hace falta si el proyecto no
# cuelga de http://localhost/stockiate/tesis_enzo.
# PHP_BASE_URL=http://localhost/stockiate/tesis_enzo


# --- SMTP (recuperación de contraseña por email) ---
# Lo lee mailer.php, que es el único archivo que manda mails. Si falta algo de
# esto, la validación es lazy como la de Groq y WhatsApp: el resto del sistema
# anda igual y sólo solicitar_reset.php responde 503 con un mensaje claro.
#
# Con Gmail: el HOST y el PUERTO son los de abajo, el USUARIO es tu dirección
# completa, y la PASSWORD **no es la de tu cuenta** sino una "contraseña de
# aplicación" de 16 caracteres, que se genera en
# https://myaccount.google.com/apppasswords y requiere tener la verificación
# en dos pasos activada. La contraseña normal la rechaza siempre con
# "535 Username and Password not accepted", que es el error que hace perder la
# primera hora.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587

# `tls` = STARTTLS (puerto 587, lo normal). `ssl` = SMTPS (puerto 465).
# Poner el modo que no corresponde al puerto da un timeout mudo.
SMTP_SEGURIDAD=tls

SMTP_USUARIO=
SMTP_PASSWORD=

# Desde qué dirección sale el mail y con qué nombre. Si se dejan vacíos se usa
# SMTP_USUARIO y "stockIAte". Con Gmail conviene dejar SMTP_DESDE vacío: mandar
# con un From distinto de la cuenta autenticada hace que Google lo reescriba.
SMTP_DESDE=
SMTP_DESDE_NOMBRE=stockIAte

# --- URL pública de la aplicación ---
# Con qué base se arma el link que va en el mail de recuperación.
#
# NO se deriva del header `Host` del request a propósito: ese header lo elige
# quien manda el pedido, y derivar el link de ahí es el agujero clásico del
# reseteo por mail (se pide el reseteo de la cuenta de otro con un Host propio,
# y a la víctima le llega un mail legítimo cuyo link apunta al servidor del
# atacante). Ver url_base_app() en reset_password.php.
#
# Si se deja vacía, cae a derivarla del request, que alcanza para desarrollo
# local. Con el túnel de ngrok levantado, completala.
APP_BASE_URL=http://localhost/stockiate/tesis_enzo
