# Entornos virtuales de Python
venv/
.venv/

# Variables de entorno: contienen API keys, nunca a git.
# La plantilla sin valores está versionada como .env.example
.env

# Cache de Python
__pycache__/
*.pyc

# Config local de Claude Code: es de tu maquina (permisos, preferencias),
# no del proyecto. El archivo se queda en disco, solo sale del control de
# versiones.
.claude/settings.local.json

# Config del backup: tiene la contraseña de MySQL. La plantilla sin valores,
# que sí va a git, es scripts/backup.conf.example.
scripts/backup.conf
